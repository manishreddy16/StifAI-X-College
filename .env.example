# OpenRouter LLM configuration (backend only; replace the placeholder locally).
# Free chat model; inference is not billed, but free endpoints can be rate limited.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Campus AI accounts + enquiries (placeholders; no secrets are stored in this file)
# Runtime mode. Production startup requires an explicitly configured PostgreSQL backend.
STIF_ENV=development
# SQLite file for users, sessions, programmes and enquiries. Contains personal data - keep it out of git and back it up.
STIF_DB_PATH=data/stif_campus.db
# Exact browser origins allowed to call the API. For hosting, use your HTTPS app origin only.
STIF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Explicit API Host header allowlist. Add the exact hosted API hostname when configured.
STIF_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Optional PostgreSQL backend. A non-empty URL selects PostgreSQL; otherwise SQLite remains active.
# Keep the real URL private. This phase does not copy records from SQLite.
# STIF_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Session lifetime in hours (default 12).
STIF_SESSION_HOURS=12
# Cookie Secure flag: auto (secure when the request is https), 1 (always) or 0 (never). Use 1 behind an HTTPS proxy.
STIF_COOKIE_SECURE=auto
# Non-interactive admin creation only: python -m api.manage create-admin (otherwise you are prompted). Never commit a real value.
# STIF_ADMIN_PASSWORD=

# Persistent public SVCE knowledge/index artifacts. Local storage is the default.
# Cloud mode requires explicit setup and a PostgreSQL advisory-lock backend.
STIF_STORAGE_BACKEND=local
# For approved Cloudflare R2 use only; private values are provisioned in the host dashboard.
# STIF_STORAGE_BUCKET=your-private-bucket
# STIF_STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# STIF_STORAGE_ACCESS_KEY_ID=your-r2-access-key-id
# STIF_STORAGE_SECRET_ACCESS_KEY=your-r2-secret-access-key
# STIF_STORAGE_PREFIX=stif-campus-ai
# STIF_STORAGE_REGION=auto
